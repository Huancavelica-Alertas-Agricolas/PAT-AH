    {
      "parameters": {
        "jsCode": "// Ensure Channel - code node\nconst out = [];\n\nfor (const it of items) {\n  const item = JSON.parse(JSON.stringify(it.json));\n\n  // Normalizar nombres comunes desde DB (por si vienen en español/inglés)\n  // Aseguramos ambos nombres: preferred_channel (snake_case) y preferredChannel (camelCase)\n  const hasPreferred = item.preferred_channel || item.preferredChannel;\n\n  if (!hasPreferred || hasPreferred === '') {\n    if (item.telefono || item.phone || item.phone_number) {\n      item.preferred_channel = 'sms';\n      item.preferredChannel = 'sms';\n    } else if (item.email) {\n      item.preferred_channel = 'email';\n      item.preferredChannel = 'email';\n    } else {\n      // No hay canal — marcamos para log y evitamos ruta de envío\n      item.__skip = true;\n    }\n  } else {\n    // Propagar valor a ambas variantes para compatibilidad\n    item.preferred_channel = item.preferred_channel || item.preferredChannel;\n    item.preferredChannel = item.preferredChannel || item.preferred_channel;\n  }\n\n  // Soporte para forceBoth (genera dos items si aplica)\n  if (item.forceBoth === true) {\n    if (item.telefono || item.phone || item.phone_number) {\n      out.push({ json: { ...item, preferred_channel: 'sms', preferredChannel: 'sms' } });\n    }\n    if (item.email) {\n      out.push({ json: { ...item, preferred_channel: 'email', preferredChannel: 'email' } });\n    }\n  } else {\n    out.push({ json: item });\n  }\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
